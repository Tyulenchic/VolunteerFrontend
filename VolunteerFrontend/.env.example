# Public base URL of the backend API (no trailing slash). Not a secret: it is embedded in the bundle.
# Local development example (ASP.NET "https" launch profile):
VITE_API_URL=https://localhost:7227

# Mailbox the admin replies to feedback from ("Ответить в Gmail" opens Gmail compose in this account).
# Not a secret. Falls back to a placeholder (aenvirel@gmail.com) when empty.
VITE_REPLY_FROM_EMAIL=
